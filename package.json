{
  "name": "@cafekery/oxide-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Oxide Design System \u2014 the shared React component library for Cafekery apps.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles": "./styles/index.css",
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vite --config workbench/vite.config.ts",
    "gallery:build": "vite build --config workbench/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:css": "bun scripts/check-tokens.ts",
    "test": "vitest run",
    "verify": "bun run lint && bun run lint:css && bun run typecheck && bun run build && bun run test && bun run gallery:build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "motion": "^12.43.0",
    "radix-ui": "^1.6.7",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
